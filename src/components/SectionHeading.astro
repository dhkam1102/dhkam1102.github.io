---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['mb-10 sm:mb-12', align === 'center' && 'text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">{subtitle}</p>}
</div>
