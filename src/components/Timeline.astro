---
import { timeline } from '../data/timeline';
---

<ol class="relative space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
  {
    timeline.map((item) => (
      <li class="relative">
        <span class="absolute -left-[25px] top-2 h-2 w-2 rounded-full bg-slate-400 dark:bg-slate-500" aria-hidden="true" />
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold tracking-tight">{item.org}</h3>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">{item.period}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400">{item.role}</p>
        <ul class="mt-3 space-y-1.5 pl-5 text-sm text-slate-700 marker:text-slate-400 dark:text-slate-300 dark:marker:text-slate-600 list-disc">
          {item.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </li>
    ))
  }
</ol>
