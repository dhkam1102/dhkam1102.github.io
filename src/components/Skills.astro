---
import { skillGroups } from '../data/skills';
---

<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
  {
    skillGroups.map((g) => (
      <div>
        <h3 class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400">
          {g.title}
        </h3>
        <ul class="space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
          {g.items.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    ))
  }
</div>
