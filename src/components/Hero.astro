---
import { site } from '../data/site';
---

<section>
  <div class="container-page pt-20 pb-16 sm:pt-28 sm:pb-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow">Hi, I'm {site.name}</p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-sm text-slate-500 dark:text-slate-500">
          {site.summary}
        </p>
        <p class="mt-2 max-w-xl italic text-slate-700 dark:text-slate-300">
          {site.joke}
        </p>


        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/projects" class="btn-accent">View projects</a>
          <a href={site.resume} target="_blank" rel="noreferrer" class="btn-primary">Resume</a>
          <a href="#contact" class="btn-ghost">Contact</a>
        </div>

      </div>

      <div class="mx-auto w-full max-w-sm">
        <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
          <img
            src={site.profileImage}
            alt={`${site.name} portrait`}
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
