---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200/70 py-8 text-sm text-slate-500 dark:border-slate-800/70 dark:text-slate-400">
  <div class="container-page flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
    <p>© {year} {site.name}. Built with Astro + Tailwind.</p>
    <div class="flex items-center gap-4">
      <a class="hover:text-accent" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="hover:text-accent" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="hover:text-accent" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</footer>
