---
import { site } from '../data/site';
---

<div class="text-center">
  <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Let's talk.</h3>
  <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
    <a
      href={site.linkedin}
      target="_blank"
      rel="noreferrer"
      class="btn border border-transparent bg-[#0A66C2] text-white hover:bg-[#084E96]"
      aria-label="LinkedIn profile"
    >
      LinkedIn
    </a>
    <a
      href={site.github}
      target="_blank"
      rel="noreferrer"
      class="btn border border-transparent bg-[#24292e] text-white hover:bg-[#1b1f23] dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
      aria-label="GitHub profile"
    >
      GitHub
    </a>
    <a
      href={`mailto:${site.email}`}
      class="btn border border-transparent bg-accent text-slate-950 hover:bg-accent-soft hover:text-white"
      aria-label={`Email ${site.email}`}
    >
      {site.email}
    </a>
  </div>
</div>
