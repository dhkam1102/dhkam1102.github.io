---
import { skillGroups } from '../data/skills';

// Order matches skillGroups in skills.ts:
// 0 Languages · 1 Cloud & Infra · 2 Tools & Frameworks · 3 Certifications · 4 Spoken Languages
const groupMeta = [
  { color: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300', dot: 'bg-blue-400' },
  { color: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300', dot: 'bg-emerald-400' },
  { color: 'bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-300', dot: 'bg-violet-400' },
  { color: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300', dot: 'bg-amber-400' },
  { color: 'bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300', dot: 'bg-rose-400' },
];

const allSkills = skillGroups.flatMap((group, gi) =>
  group.items.map((item) => ({
    label: item,
    colorClass: groupMeta[gi % groupMeta.length].color,
  }))
);
---

<div class="space-y-4">
  <!-- Capsule bin container -->
  <div class="relative overflow-hidden rounded-3xl border-2 border-slate-200 bg-gradient-to-b from-slate-50 to-white px-6 pb-8 pt-6 dark:border-slate-700 dark:from-slate-800/60 dark:to-slate-900/40">
    <!-- Glass shine at top -->
    <div
      class="pointer-events-none absolute inset-x-4 top-0 h-12 rounded-b-full bg-gradient-to-b from-white/60 to-transparent dark:from-white/10"
      aria-hidden="true"
    />
    <!-- Side gloss -->
    <div
      class="pointer-events-none absolute bottom-4 left-0 top-12 w-3 rounded-r-full bg-gradient-to-r from-white/30 to-transparent dark:from-white/5"
      aria-hidden="true"
    />

    <!-- Floating bubbles -->
    <div class="flex flex-wrap gap-2">
      {
        allSkills.map((skill) => (
          <span
            class={`bubble inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium select-none ${skill.colorClass}`}
          >
            {skill.label}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap gap-x-5 gap-y-1.5 px-1">
    {
      skillGroups.map((group, gi) => (
        <span class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
          <span class={`inline-block h-2 w-2 rounded-full ${groupMeta[gi].dot}`} />
          {group.title}
        </span>
      ))
    }
  </div>
</div>

<style>
